@startuml SistemaMonitoramentoAlunos

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}

enum Situacao {
    ATIVO = 1
    INATIVO = 0
}

enum TipoSanguineo {
    A_POSITIVO
    A_NEGATIVO
    B_POSITIVO
    B_NEGATIVO
    AB_POSITIVO
    AB_NEGATIVO
    O_POSITIVO
    O_NEGATIVO
}

enum TipoExercicio {
    NORMAL
    DROPSET
    BISET
}

enum TreinoPeriodoTipo {
    DIARIO
    SEMANAL
    QUINZENAL
    MENSAL
}

enum TreinoTipo {
    MUSCULACAO
    CARDIO
    FUNCIONAL
    HIIT
}

class Aluno {
    .. Dados vindos do sistema de usuários ..
    - id : Long
    - dataCriacao : DateTime
    - dataAlteracao : DateTime
    - nome : String
    - sobrenome : String
    - dtNascimento : Date
    - cpf : String
    - endereco : String
    - tipoSanguineo : TipoSanguineo
    - whatsapp : String
    - email : String
    - situacao : Situacao
    - foto : String
    .. Dados preenchidos apenas no monitoramento ..
    - peso : Double
    - altura : Double
    - percentualGorduraCorporal : Double
    - imc : Double
    - circunferencias : String
    - historicoLesoes : String
    - condicoesMedicas : String
    - usoMedicamentosContinuos : String
    - restricoesMedicas : String
    - parQ : String
    - atestadoMedico : String
    __
    + calcularImc() : Double
}

class Exercicio {
    - id : Long
    - dataCriacao : DateTime
    - dataAlteracao : DateTime
    - nomeExercicio : String
    - musculo : String
}

class ItemExercicio {
    - id : Long
    - dataCriacao : DateTime
    - dataAlteracao : DateTime
    - serie : Integer
    - repeticoes : Integer
    - tipoExercicio : TipoExercicio
}

class Treino {
    - id : Long
    - dataCriacao : DateTime
    - dataAlteracao : DateTime
    - treinoPeriodo : TreinoPeriodoTipo
    - tipo : TreinoTipo
    - treinoMesVigente : String
}

' ---- Relacionamentos ----

Aluno "1" -- "0..*" Treino : possui

Treino "1" -- "0..*" ItemExercicio : contém

ItemExercicio "0..*" -- "1" Exercicio : refere-se a

ItemExercicio "0..1" -- "0..*" ItemExercicio : agrupa\n(biset/dropset)

Aluno ..> Situacao
Aluno ..> TipoSanguineo
ItemExercicio ..> TipoExercicio
Treino ..> TreinoPeriodoTipo
Treino ..> TreinoTipo

@enduml