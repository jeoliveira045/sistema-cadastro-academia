@startuml SistemaCadastroAlunosProfessores

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}

enum Situacao {
    ATIVO = 1
    INATIVO = 0
}

enum TipoSanguineo {
    A_POSITIVO
    A_NEGATIVO
    B_POSITIVO
    B_NEGATIVO
    AB_POSITIVO
    AB_NEGATIVO
    O_POSITIVO
    O_NEGATIVO
}

enum Genero {
    MASCULINO
    FEMININO
    OUTRO
    NAO_INFORMADO
}

abstract class Pessoa {
    - id : Long
    - dataCriacao : DateTime
    - dataAlteracao : DateTime
    - nome : String
    - sobrenome : String
    - dtNascimento : Date
    - cpf : String
    - endereco : String
    - tipoSanguineo : TipoSanguineo
    - email : String
    - genero : Genero
    - situacao : Situacao
    __
    + getNomeCompleto() : String
}

class Aluno extends Pessoa {
}

class Professor extends Pessoa {
    - cref : String
}

Pessoa <|-- Aluno
Pessoa <|-- Professor

Pessoa "1" -- "1" TipoSanguineo
Pessoa "1" -- "1" Genero
Pessoa "1" -- "1" Situacao

@enduml